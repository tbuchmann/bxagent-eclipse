<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- ===== View ===== -->
   <extension point="org.eclipse.ui.views">
      <category
            id="dev.bxagent.eclipse.category"
            name="BXAgent"/>
      <view
            id="dev.bxagent.eclipse.ui.BXAgentView"
            name="BXAgent Chat"
            category="dev.bxagent.eclipse.category"
            class="dev.bxagent.eclipse.ui.BXAgentView"
            icon="icons/bxagent.png"
            allowMultiple="false"/>
   </extension>

   <!-- ===== Preference page ===== -->
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="dev.bxagent.eclipse.preferences.BXAgentPreferencePage"
            name="BXAgent"
            class="dev.bxagent.eclipse.preferences.BXAgentPreferencePage"/>
   </extension>

   <!-- ===== Preference initializer ===== -->
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer
            class="dev.bxagent.eclipse.preferences.BXAgentPreferenceInitializer"/>
   </extension>

   <!-- ===== Command: open view ===== -->
   <extension point="org.eclipse.ui.commands">
      <command
            id="dev.bxagent.eclipse.openView"
            name="Open BXAgent Chat"
            description="Opens the BXAgent Chat view"/>
   </extension>

   <!-- ===== Handler: show the view ===== -->
   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="dev.bxagent.eclipse.openView"
            class="dev.bxagent.eclipse.handlers.OpenBXAgentViewHandler"/>
   </extension>

   <!-- ===== Key binding: Ctrl+Shift+B ===== -->
   <extension point="org.eclipse.ui.bindings">
      <key
            sequence="M1+M2+B"
            commandId="dev.bxagent.eclipse.openView"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>

</plugin>
